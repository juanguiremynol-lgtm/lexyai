{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qvuukbqcvlnvmcvcruji.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "andromeda-mcp",
      "version": "0.3.0",
      "title": "Andromeda Legal"
    },
    "tools": [
      {
        "name": "get_user_context",
        "title": "Contexto del abogado",
        "description": "Returns the signed-in lawyer's profile (name, firm) and portfolio counters (active matters by workflow type). Call this first so you can address the user correctly without asking.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "search",
        "title": "Búsqueda libre",
        "description": "Free-text search across the caller's matters: radicado, título, partes (demandantes/demandados), authority (despacho) and city. Use it for natural queries like 'el caso contra Bancolombia en Medellín'. Results are RLS-scoped to the caller.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Texto libre: parte, despacho, ciudad, radicado o título."
            },
            "workflow_type": {
              "type": "string",
              "description": "Filtro opcional: CGP, CPACA, LABORAL, PENAL, TUTELA, PETICION."
            },
            "city": {
              "type": "string",
              "description": "Filtro opcional por ciudad del despacho."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Máximo de resultados (default 20)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_work_items",
        "title": "Listar asuntos (work items)",
        "description": "Lists the signed-in user's active legal matters (asuntos) from Andromeda. Supports optional text search and workflow_type filter (CGP, CPACA, LABORAL, PENAL, TUTELA, PETICION).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Free-text match on radicado, título, partes, o autoridad."
            },
            "workflow_type": {
              "type": "string",
              "description": "Filter by workflow_type, e.g. CGP, CPACA, LABORAL, PENAL, TUTELA, PETICION."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_work_item",
        "title": "Detalle de asunto",
        "description": "Fetches details for one legal matter (work_item) by id or by radicado, including recent actuaciones and estados.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "work_item UUID."
            },
            "radicado": {
              "type": "string",
              "description": "Radicado exacto (23-dígitos u otro formato)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_actuaciones",
        "title": "Actuaciones de un asunto",
        "description": "Lists judicial actuaciones for one matter, newest first. Identify the matter by radicado or work item id. Archived and superseded rows are excluded.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "radicado": {
              "type": "string",
              "description": "Radicado del asunto."
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del asunto (alternativa al radicado)."
            },
            "date_from": {
              "type": "string",
              "description": "Fecha inicial YYYY-MM-DD (sobre act_date)."
            },
            "date_to": {
              "type": "string",
              "description": "Fecha final YYYY-MM-DD (sobre act_date)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de filas (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_publicaciones",
        "title": "Estados electrónicos de un asunto",
        "description": "Lists electronic estados / publicaciones procesales for one matter, newest fijación first. Identify the matter by radicado or work item id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "radicado": {
              "type": "string",
              "description": "Radicado del asunto."
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del asunto."
            },
            "date_from": {
              "type": "string",
              "description": "Fecha inicial YYYY-MM-DD (sobre fecha_fijacion)."
            },
            "date_to": {
              "type": "string",
              "description": "Fecha final YYYY-MM-DD (sobre fecha_fijacion)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de filas (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_estados",
        "title": "Novedades judiciales recientes",
        "description": "Lists the most recent judicial estados / actuaciones detected across the signed-in user's monitored matters, ordered by detected_at desc.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Ventana en días (default 3)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo filas (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_estados_hoy",
        "title": "Estados de hoy",
        "description": "Lists estados electrónicos fijados TODAY (America/Bogota) across the whole portfolio. An estado belongs to a day when its fecha_fijacion equals that calendar day in Bogota — not when it was detected.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Día YYYY-MM-DD en America/Bogota. Default: hoy."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de filas (default 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_actuaciones_hoy",
        "title": "Actuaciones recientes de la cartera",
        "description": "Lists actuaciones registered across the whole portfolio within a recent window (today, last 3 days, or last week), based on act_date in America/Bogota.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Día final YYYY-MM-DD en America/Bogota. Default: hoy."
            },
            "window": {
              "type": "string",
              "enum": [
                "today",
                "3days",
                "week"
              ],
              "description": "Ventana hacia atrás. Default: today."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de filas (default 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_deadlines",
        "title": "Términos procesales",
        "description": "Lists procedural deadlines (términos). By default only genuinely active deadlines are returned; deadlines flagged PENDING_REVIEW are historical/backfilled and are NOT active — request them explicitly and never present them as live obligations.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "pending_review",
                "all"
              ],
              "description": "Default: pending (solo activos)."
            },
            "radicado": {
              "type": "string",
              "description": "Limitar a un asunto por radicado."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de filas (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_alerts",
        "title": "Alertas del abogado",
        "description": "Lists the caller's judicial alerts (alert_instances). Default: unresolved alerts (PENDING and ACKNOWLEDGED), newest first. Use it to answer 'how many unread alerts do I have'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "work_item_id": {
              "type": "string",
              "format": "uuid",
              "description": "Limitar a un asunto (UUID)."
            },
            "radicado": {
              "type": "string",
              "description": "Limitar a un asunto por radicado."
            },
            "status": {
              "type": "string",
              "enum": [
                "PENDING",
                "ACKNOWLEDGED",
                "RESOLVED",
                "all"
              ],
              "description": "Default: pendientes + reconocidas."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo de filas (default 30)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_hearings",
        "title": "Audiencias programadas",
        "description": "Lists scheduled hearings (audiencias) from the canonical work_item_hearings table, RLS-scoped to the caller. Optionally filter by matter and by date range (ISO dates, America/Bogota calendar).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "work_item_id": {
              "type": "string",
              "format": "uuid",
              "description": "Limitar a un asunto (UUID)."
            },
            "radicado": {
              "type": "string",
              "description": "Limitar a un asunto por radicado."
            },
            "date_from": {
              "type": "string",
              "description": "Fecha inicial ISO (YYYY-MM-DD)."
            },
            "date_to": {
              "type": "string",
              "description": "Fecha final ISO (YYYY-MM-DD)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo de filas (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "Tareas de expedientes",
        "description": "Lists the caller's tasks (work_item_tasks), optionally filtered by matter and status. Default: open tasks ordered by due date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "work_item_id": {
              "type": "string",
              "format": "uuid",
              "description": "Limitar a un asunto (UUID)."
            },
            "radicado": {
              "type": "string",
              "description": "Limitar a un asunto por radicado."
            },
            "status": {
              "type": "string",
              "description": "Estado exacto (p. ej. PENDING, IN_PROGRESS, COMPLETED) o 'all'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo de filas (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_document_url",
        "title": "Enlace del documento de una publicación",
        "description": "Returns a short-lived download URL for the PDF attached to a publicación (estado electrónico) of one of the caller's matters. It never generates new documents; it only exposes an existing attachment under the established access policy.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "work_item_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del asunto."
            },
            "radicado": {
              "type": "string",
              "description": "Radicado del asunto."
            },
            "document_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID de la publicación (estado) cuyo PDF se solicita."
            }
          },
          "required": [
            "document_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "Listar clientes",
        "description": "Lists the signed-in lawyer's clients with the number of active matters linked to each one.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Búsqueda por nombre o identificación."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de filas (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_client",
        "title": "Detalle de cliente",
        "description": "Fetches one client and the matters linked to them. Identify the client by id or by exact/partial name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del cliente."
            },
            "name": {
              "type": "string",
              "description": "Nombre del cliente (coincidencia parcial)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_note",
        "title": "Agregar nota a un asunto",
        "description": "Appends a timestamped note to a matter's notes field. This is the only write operation exposed over MCP: it never deletes, reclassifies, or changes the lifecycle of a matter.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "radicado": {
              "type": "string",
              "description": "Radicado del asunto."
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del asunto."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "Texto de la nota."
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_hearing",
        "title": "Agendar audiencia",
        "description": "Schedules a hearing (audiencia) on one of the caller's matters. Requires the read_write scope. It only inserts new hearings: it never deletes, reschedules by deletion, reclassifies, or changes the lifecycle of a matter.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "work_item_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del asunto."
            },
            "radicado": {
              "type": "string",
              "description": "Radicado del asunto."
            },
            "date": {
              "type": "string",
              "description": "Fecha y hora ISO 8601, p. ej. 2026-08-14T09:00:00-05:00 (hora de Bogotá)."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Nombre o descripción de la audiencia."
            },
            "location": {
              "type": "string",
              "maxLength": 300,
              "description": "Lugar o enlace de la audiencia."
            }
          },
          "required": [
            "date",
            "description"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
